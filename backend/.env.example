# Hearth backend configuration. Copy to .env — every value here is optional.

FLASK_ENV=development
PORT=5274

# Local LLM for the AI Insights page. Hearth works fine without Ollama running;
# only that page needs it. `ollama pull llama3.2:3b` then set the name here.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# DATABASE_URL is intentionally NOT set. Leave it alone and Hearth stores the
# database at backend/data/finance.db, resolved from the source tree.
# If you do set it, it MUST be an absolute path: Flask-SQLAlchemy resolves a
# relative sqlite path against backend/instance/, not the project, so
# "sqlite:///data/finance.db" fails with "unable to open database file".
#   Windows: DATABASE_URL=sqlite:///C:/Users/you/hearth/finance.db
#   mac/Linux: DATABASE_URL=sqlite:////home/you/hearth/finance.db
